rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == 'maria.medina@uptc.edu.co')
      );
    }

    function isValidAttendee(data) {
      return data.keys().hasAll([
        'fullName', 'email', 'role', 'organization', 'attendanceType', 'primaryTrack', 'ticketNumber', 'status'
      ]) &&
      data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 100 &&
      data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
      data.role is string && (
        data.role == 'Estudiante UPTC' ||
        data.role == 'Estudiante Otra Universidad' ||
        data.role == 'Desarrollador / Ingeniero' ||
        data.role == 'Docente / Investigador' ||
        data.role == 'Líder Tech / Empresa'
      ) &&
      data.organization is string && data.organization.size() <= 120 &&
      data.attendanceType is string && (data.attendanceType == 'presencial' || data.attendanceType == 'streaming') &&
      data.primaryTrack is string && (
        data.primaryTrack == 'Ambos (Java + IA)' ||
        data.primaryTrack == 'Core Java & Loom' ||
        data.primaryTrack == 'IA Generativa & LangChain4j'
      ) &&
      data.ticketNumber is string && data.ticketNumber.size() <= 64 &&
      data.status is string && (
        data.status == 'confirmado' ||
        data.status == 'pendiente' ||
        data.status == 'checkin' ||
        data.status == 'cancelado'
      );
    }

    // Attendees collection
    match /attendees/{attendeeId} {
      // Allow reading attendee by id for checking credentials, or list for authorized users/admins
      allow get: if isValidId(attendeeId);
      allow list: if true;

      // Allow creating an attendee record (e.g. self-registration or admin)
      allow create: if isValidId(attendeeId) && isValidAttendee(incoming());

      // Allow updating by the owner or administrator
      allow update: if isValidId(attendeeId) && isValidAttendee(incoming()) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid) ||
        // Check-in or status update by staff
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'notes'])
      );

      // Only administrators can delete records
      allow delete: if isValidId(attendeeId) && (
        isAdmin() ||
        (isSignedIn() && existing().userId == request.auth.uid)
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
