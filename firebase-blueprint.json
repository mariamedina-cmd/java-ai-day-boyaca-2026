{
  "entities": {
    "attendee": {
      "title": "Attendee",
      "description": "Registro de participante o asistente oficial al evento Java & AI Day Boyacá 2026.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Nombre completo del asistente",
          "minLength": 3,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Correo electrónico del asistente",
          "format": "email",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Perfil o rol institucional del participante",
          "enum": [
            "Estudiante UPTC",
            "Estudiante Otra Universidad",
            "Desarrollador / Ingeniero",
            "Docente / Investigador",
            "Líder Tech / Empresa"
          ]
        },
        "organization": {
          "type": "string",
          "description": "Institución universitaria o empresa de procedencia",
          "maxLength": 120
        },
        "attendanceType": {
          "type": "string",
          "description": "Modalidad de asistencia (presencial en Tunja o streaming)",
          "enum": ["presencial", "streaming"]
        },
        "primaryTrack": {
          "type": "string",
          "description": "Eje temático principal de interés",
          "enum": [
            "Ambos (Java + IA)",
            "Core Java & Loom",
            "IA Generativa & LangChain4j"
          ]
        },
        "ticketNumber": {
          "type": "string",
          "description": "Identificador único de escarapela / credencial",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "Estado de la acreditación en el evento",
          "enum": ["confirmado", "pendiente", "checkin", "cancelado"]
        },
        "notes": {
          "type": "string",
          "description": "Observaciones organizativas o requerimientos especiales",
          "maxLength": 500
        },
        "userId": {
          "type": "string",
          "description": "UID de Firebase Authentication del usuario creador si aplica",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Fecha y hora de creación del registro"
        },
        "updatedAt": {
          "type": "string",
          "description": "Fecha y hora de la última modificación"
        }
      },
      "required": [
        "fullName",
        "email",
        "role",
        "organization",
        "attendanceType",
        "primaryTrack",
        "ticketNumber",
        "status"
      ]
    },
    "admin": {
      "title": "Admin",
      "description": "Administrador del sistema con privilegios de gestión de asistentes y control de acceso.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Correo del administrador",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "Rol de administración",
          "enum": ["superadmin", "organizador", "staff"]
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/attendees/{attendeeId}": {
      "schema": "attendee",
      "description": "Colección central de registros de asistentes con operaciones CRUD, control de asistencia y verificación de escarapelas."
    },
    "/admins/{adminId}": {
      "schema": "admin",
      "description": "Documentos de administradores y comité organizador autorizados para operaciones avanzadas."
    }
  }
}
